{
  "manifest_version": 3,
  "name": "AutoFill IA",
  "version": "1.0.0",
  "description": "Identifica campos de formulário automaticamente (heurística + IA gratuita opcional) e preenche com seus dados.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fields.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "fill-now": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Preencher formulário da página"
    }
  }
}